<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PreviousPractice.ViewModels"
             xmlns:models="clr-namespace:PreviousPractice.Models"
             x:Class="PreviousPractice.SourceFileReviewPage"
             x:DataType="viewModels:SourceFileReviewViewModel"
             x:Name="ReviewPage"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="진단"
                     Clicked="OnOpenDiagnosticsClicked"
                     IsEnabled="{Binding CanOpenDiagnostics}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="16">
        <Frame Grid.Row="0" Padding="16" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding HeaderText}"
                       FontAttributes="Bold"
                       FontSize="20"
                       LineBreakMode="TailTruncation"
                       TextColor="#0F172A"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding SummaryText}" FontSize="12" TextColor="#475569" />
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Start"
                                   Color="#0F766E"
                                   SemanticProperties.Description="문항과 진단 정보 불러오는 중" />
                <Label Text="저장된 문제 이미지를 우선 확인하고, 구조 실패 원인은 상단 '진단'에서 분리해서 봅니다." FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Frame>

        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding UseWideLayout}" ColumnDefinitions="280,*" ColumnSpacing="16">
                <Frame Grid.Column="0" Padding="14" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <VerticalStackLayout Grid.Row="0" Spacing="4">
                            <Label Text="문항 목록" FontAttributes="Bold" FontSize="18" TextColor="#0F172A" />
                            <Label Text="문항을 선택하면 이미지 위치와 확대율을 초기화해 처음부터 보여줍니다." FontSize="12" TextColor="#64748B" />
                        </VerticalStackLayout>

                        <CollectionView x:Name="WideQuestionList"
                                        Grid.Row="1"
                                        ItemsSource="{Binding Questions}"
                                        SelectedItem="{Binding CurrentQuestion, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        EmptyView="저장된 문항이 없습니다.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Question">
                                    <Frame Padding="12" Margin="0,0,0,10" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#EFF6FF" />
                                                        <Setter Property="BorderColor" Value="#2563EB" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{Binding Index, StringFormat='{}{0}번'}" FontAttributes="Bold" TextColor="#0F172A" />
                                                <Label Grid.Column="1" Text="{Binding CorrectAnswerDisplay}" TextColor="#0F766E" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                                            </Grid>
                                            <Label Text="{Binding Prompt}" FontSize="12" TextColor="#475569" LineBreakMode="TailTruncation" MaxLines="2" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Frame>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                    <Frame Grid.Row="0" Padding="14" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="이전" Command="{Binding PreviousQuestionCommand}" IsEnabled="{Binding CanGoPrevious}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding CurrentQuestionDisplayTitle}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="{Binding CurrentQuestionPositionText}" HorizontalTextAlignment="Center" FontSize="12" TextColor="#475569" />
                                <Label Text="{Binding CurrentAnswerDisplay}" HorizontalTextAlignment="Center" FontSize="12" TextColor="#0F766E" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="다음" Command="{Binding NextQuestionCommand}" IsEnabled="{Binding CanGoNext}" />
                        </Grid>
                    </Frame>

                    <Frame Grid.Row="1" Padding="14" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasCurrentQuestionImages}">
                                <Button Text="-" WidthRequest="44" HeightRequest="44" Padding="0" Command="{Binding DecreaseQuestionImageZoomCommand}" IsEnabled="{Binding CanDecreaseQuestionImageZoom}" SemanticProperties.Description="문제 이미지 축소" />
                                <Button Grid.Column="1" Text="100%" HeightRequest="44" Padding="10,0" Command="{Binding ResetQuestionImageZoomCommand}" IsEnabled="{Binding CanResetQuestionImageZoom}" SemanticProperties.Description="문제 이미지 원래 크기로 초기화" />
                                <Label Grid.Column="2" Text="{Binding QuestionImageZoomText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#475569" />
                                <Button Grid.Column="3" Text="+" WidthRequest="44" HeightRequest="44" Padding="0" Command="{Binding IncreaseQuestionImageZoomCommand}" IsEnabled="{Binding CanIncreaseQuestionImageZoom}" SemanticProperties.Description="문제 이미지 확대" />
                            </Grid>

                            <ScrollView x:Name="WideReviewImageScroll" Grid.Row="1" Orientation="Both" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Default">
                                <ScrollView.GestureRecognizers>
                                    <PinchGestureRecognizer PinchUpdated="OnQuestionImagePinchUpdated" />
                                </ScrollView.GestureRecognizers>
                                <VerticalStackLayout Spacing="12">
                                    <VerticalStackLayout Spacing="10"
                                                        Scale="{Binding QuestionImagePreviewScale}"
                                                        AnchorX="0"
                                                        AnchorY="0"
                                                        IsVisible="{Binding HasCurrentQuestionImages}"
                                                        BindableLayout.ItemsSource="{Binding CurrentQuestionImageSlices}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:QuestionImageSliceViewModel">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding PageIndex, StringFormat='PDF {0}페이지'}" FontSize="11" TextColor="#64748B" />
                                                    <Grid WidthRequest="{Binding VisibleWidth}" HeightRequest="{Binding VisibleHeight}" IsClippedToBounds="True" HorizontalOptions="Start">
                                                        <Image Source="{Binding ImageSource}" WidthRequest="{Binding ContentWidth}" HeightRequest="{Binding ContentHeight}" TranslationX="{Binding TranslationX}" TranslationY="{Binding TranslationY}" HorizontalOptions="Start" VerticalOptions="Start" Aspect="AspectFit" SemanticProperties.Description="{Binding AccessibilityDescription}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Label Text="{Binding CurrentQuestionText}" IsVisible="{Binding ShowCurrentQuestionText}" LineBreakMode="WordWrap" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </ScrollView>

                            <Frame Grid.Row="2" Padding="10" BorderColor="#FBBF24" BackgroundColor="#FFFBEB" HasShadow="False" IsVisible="{Binding HasQuestionImageNotice}">
                                <Label Text="{Binding QuestionImageNotice}" TextColor="#92400E" LineBreakMode="WordWrap" />
                            </Frame>
                        </Grid>
                    </Frame>
                </Grid>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding UseWideLayout}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>

                <Frame Grid.Row="0" Padding="14" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="이전" Command="{Binding PreviousQuestionCommand}" IsEnabled="{Binding CanGoPrevious}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding CurrentQuestionDisplayTitle}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="{Binding CurrentQuestionPositionText}" HorizontalTextAlignment="Center" FontSize="12" TextColor="#475569" />
                            <Label Text="{Binding CurrentAnswerDisplay}" HorizontalTextAlignment="Center" FontSize="12" TextColor="#0F766E" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="다음" Command="{Binding NextQuestionCommand}" IsEnabled="{Binding CanGoNext}" />
                    </Grid>
                </Frame>

                <Frame Grid.Row="1" Padding="8" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                    <CollectionView x:Name="NarrowQuestionList"
                                    ItemsSource="{Binding Questions}"
                                    SelectedItem="{Binding CurrentQuestion, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="76"
                                    EmptyView="저장된 문항이 없습니다.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Question">
                                <Frame Padding="12,8" Margin="0,0,8,0" BorderColor="#CBD5E1" BackgroundColor="#F8FAFC" HasShadow="False" MinimumWidthRequest="60">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#DBEAFE" />
                                                    <Setter Property="BorderColor" Value="#2563EB" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding Index, StringFormat='{}{0}번'}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <Frame Grid.Row="2" Padding="14" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasCurrentQuestionImages}">
                            <Button Text="-" WidthRequest="44" HeightRequest="44" Padding="0" Command="{Binding DecreaseQuestionImageZoomCommand}" IsEnabled="{Binding CanDecreaseQuestionImageZoom}" SemanticProperties.Description="문제 이미지 축소" />
                            <Button Grid.Column="1" Text="100%" HeightRequest="44" Padding="10,0" Command="{Binding ResetQuestionImageZoomCommand}" IsEnabled="{Binding CanResetQuestionImageZoom}" SemanticProperties.Description="문제 이미지 원래 크기로 초기화" />
                            <Label Grid.Column="2" Text="{Binding QuestionImageZoomText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#475569" />
                            <Button Grid.Column="3" Text="+" WidthRequest="44" HeightRequest="44" Padding="0" Command="{Binding IncreaseQuestionImageZoomCommand}" IsEnabled="{Binding CanIncreaseQuestionImageZoom}" SemanticProperties.Description="문제 이미지 확대" />
                        </Grid>

                        <ScrollView x:Name="NarrowReviewImageScroll" Grid.Row="1" Orientation="Both" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Default">
                            <ScrollView.GestureRecognizers>
                                <PinchGestureRecognizer PinchUpdated="OnQuestionImagePinchUpdated" />
                            </ScrollView.GestureRecognizers>
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="10"
                                                    Scale="{Binding QuestionImagePreviewScale}"
                                                    AnchorX="0"
                                                    AnchorY="0"
                                                    IsVisible="{Binding HasCurrentQuestionImages}"
                                                    BindableLayout.ItemsSource="{Binding CurrentQuestionImageSlices}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:QuestionImageSliceViewModel">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding PageIndex, StringFormat='PDF {0}페이지'}" FontSize="11" TextColor="#64748B" />
                                                <Grid WidthRequest="{Binding VisibleWidth}" HeightRequest="{Binding VisibleHeight}" IsClippedToBounds="True" HorizontalOptions="Start">
                                                    <Image Source="{Binding ImageSource}" WidthRequest="{Binding ContentWidth}" HeightRequest="{Binding ContentHeight}" TranslationX="{Binding TranslationX}" TranslationY="{Binding TranslationY}" HorizontalOptions="Start" VerticalOptions="Start" Aspect="AspectFit" SemanticProperties.Description="{Binding AccessibilityDescription}" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="{Binding CurrentQuestionText}" IsVisible="{Binding ShowCurrentQuestionText}" LineBreakMode="WordWrap" TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </ScrollView>

                        <Frame Grid.Row="2" Padding="10" BorderColor="#FBBF24" BackgroundColor="#FFFBEB" HasShadow="False" IsVisible="{Binding HasQuestionImageNotice}">
                            <Label Text="{Binding QuestionImageNotice}" TextColor="#92400E" LineBreakMode="WordWrap" />
                        </Frame>
                    </Grid>
                </Frame>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
