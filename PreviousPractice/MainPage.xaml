                                           IsEnabled="{Binding CanEnterAnswer}"
                                           ClearButtonVisibility="WhileEditing"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding SubmitAnswerCommand}"
                                           SemanticProperties.Description="현재 문제의 답 입력" />
                                    <Button Text="{Binding SubmitAnswerButtonText}"
                                            Command="{Binding SubmitAnswerCommand}"
                                            IsEnabled="{Binding CanSubmitAnswer}"
