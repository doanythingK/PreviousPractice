                                           IsVisible="{Binding HasQuestionImageNotice}">
                                        <Label Text="{Binding QuestionImageNotice}"
                                               TextColor="#92400E"
                                               LineBreakMode="WordWrap" />
                                    </Frame>

                                    <Label Text="{Binding CurrentQuestionChoicesText}" IsVisible="{Binding ShowCurrentQuestionText}" />

                                    <Entry x:Name="NarrowPracticeAnswerEntry"
                                           Placeholder="답 입력"
