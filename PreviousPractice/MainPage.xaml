                                            <Frame Padding="12" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                                                <VerticalStackLayout Spacing="10">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="{Binding DisplayText}" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding SourceFileName}" FontSize="12" TextColor="#64748B" LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Button Text="보기" Clicked="OnOpenSourceFileReviewClicked" CommandParameter="{Binding}" />
                                                        <Button Text="삭제"
                                                                Clicked="OnDeleteSourceFileClicked"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanDelete}"
                                                                BackgroundColor="#FEF2F2"
                                                                TextColor="#B91C1C"
                                                                SemanticProperties.Description="이 파일에 저장된 문항 삭제" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
