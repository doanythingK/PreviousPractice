                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="현재 문제" FontAttributes="Bold" FontSize="20" TextColor="#0F172A" />
                                            <Label Text="{Binding ProgressDisplay}" TextColor="#0F766E" FontAttributes="Bold" />
                                            <Label Text="{Binding CurrentQuestionSourceDisplay}" FontSize="12" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="종료"
                                                Command="{Binding StopPracticeCommand}"
                                                IsEnabled="{Binding CanStopPractice}"
                                                BackgroundColor="#FFF7ED"
                                                TextColor="#C2410C"
                                                SemanticProperties.Description="현재 연습을 중간에 종료" />
                                    </Grid>

                                    <Label Text="{Binding CurrentQuestionText}" FontAttributes="Bold" FontSize="18" IsVisible="{Binding ShowCurrentQuestionText}" />

                                    <VerticalStackLayout Spacing="8"
                                                         IsVisible="{Binding HasCurrentQuestionImages}"
                                                         SemanticProperties.Description="{Binding CurrentQuestionSemanticDescription}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                            <Button Text="-" WidthRequest="44" HeightRequest="44" Padding="0" Command="{Binding DecreaseQuestionImageZoomCommand}" IsEnabled="{Binding CanDecreaseQuestionImageZoom}" SemanticProperties.Description="문제 이미지 축소" />
                                            <Button Grid.Column="1" Text="100%" HeightRequest="44" Padding="10,0" Command="{Binding ResetQuestionImageZoomCommand}" IsEnabled="{Binding CanResetQuestionImageZoom}" SemanticProperties.Description="문제 이미지 원래 크기로 초기화" />
                                            <Label Grid.Column="2" Text="{Binding QuestionImageZoomText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#475569" />
                                            <Button Grid.Column="3" Text="+" WidthRequest="44" HeightRequest="44" Padding="0" Command="{Binding IncreaseQuestionImageZoomCommand}" IsEnabled="{Binding CanIncreaseQuestionImageZoom}" SemanticProperties.Description="문제 이미지 확대" />
                                        </Grid>
