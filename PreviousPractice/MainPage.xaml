<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PreviousPractice.ViewModels"
             xmlns:models="clr-namespace:PreviousPractice.Models"
             x:Class="PreviousPractice.MainPage"
             x:DataType="viewModels:MainViewModel"
             x:Name="Root"
             Title="기출문제 연습프로그램"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ContentPage.BindingContext>
        <viewModels:MainViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Frame Grid.Row="0" Padding="12" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="기출문제 연습프로그램"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           VerticalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding UseWideWorkspaceLayout}" Value="True">
                                <Setter Property="FontSize" Value="30" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.Column="1"
                            Text="{Binding TopSummaryToggleText}"
                            Command="{Binding ToggleTopSummaryCommand}"
                            Padding="12,6"
                            HeightRequest="36"
                            CornerRadius="10"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A"
                            BorderColor="#CBD5E1"
                            BorderWidth="1" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="12" IsVisible="{Binding IsTopSummaryExpanded}">
                    <Label Text="작업, 연습, 오답을 분리해서 현재 해야 할 일만 보이도록 정리했습니다." TextColor="#475569" LineBreakMode="WordWrap" />

                    <Grid IsVisible="{Binding UseWideWorkspaceLayout}" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Frame Grid.Column="0" Padding="12" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="현재 카테고리 문항" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding SelectedCategoryQuestionCountText}" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" Padding="12" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="연습 가능 최대" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding MaxPracticeCount}" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="2" Padding="12" BorderColor="#D1FAE5" BackgroundColor="#F0FDFA" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="오답 수" FontSize="12" TextColor="#0F766E" />
                                <Label Text="{Binding WrongQuestionCount}" FontSize="24" FontAttributes="Bold" TextColor="#0F766E" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding UseWideWorkspaceLayout}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Frame Grid.Row="0" Grid.Column="0" Padding="12" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="현재 카테고리 문항" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding SelectedCategoryQuestionCountText}" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="1" Padding="12" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="연습 가능 최대" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding MaxPracticeCount}" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.ColumnSpan="2" Padding="12" BorderColor="#D1FAE5" BackgroundColor="#F0FDFA" HasShadow="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="오답 수" FontSize="12" TextColor="#0F766E" />
                                <Label Text="{Binding WrongQuestionCount}" FontSize="22" FontAttributes="Bold" TextColor="#0F766E" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Frame Padding="12"
                   BorderColor="#BFDBFE"
                   BackgroundColor="#EFF6FF"
                   HasShadow="False"
                   IsVisible="{Binding IsInitializing}">
                <HorizontalStackLayout Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsInitializing}" Color="#0EA5E9" />
                    <Label Text="앱 데이터와 저장된 문항을 불러오는 중입니다."
                           VerticalTextAlignment="Center"
                           TextColor="#1E3A8A" />
                </HorizontalStackLayout>
            </Frame>

            <Frame Padding="12"
                   BorderColor="{Binding FeedbackBorderColor}"
                   BackgroundColor="{Binding FeedbackBackgroundColor}"
                   HasShadow="False"
                   IsVisible="{Binding HasFeedback}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding FeedbackTitle}"
                           FontAttributes="Bold"
                           TextColor="{Binding FeedbackTitleColor}"
                           VerticalTextAlignment="Start" />
                    <Label Grid.Column="1"
                           Text="{Binding Feedback}"
                           TextColor="#334155"
                           LineBreakMode="WordWrap"
                           MaxLines="5" />
                    <Button Grid.Column="2"
                            Text="닫기"
                            Command="{Binding ClearFeedbackCommand}"
                            Padding="10,4"
                            MinimumHeightRequest="36"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="#475569"
                            SemanticProperties.Description="상태 메시지 닫기" />
                </Grid>
            </Frame>

            <Frame Padding="8" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="작업" Command="{Binding ShowImportWorkspaceCommand}" CornerRadius="12" Padding="14,10" BackgroundColor="#E2E8F0" TextColor="#0F172A" SemanticProperties.Description="카테고리와 PDF 가져오기 화면 열기">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsImportWorkspaceSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0F172A" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="연습" Command="{Binding ShowPracticeWorkspaceCommand}" CornerRadius="12" Padding="14,10" BackgroundColor="#E2E8F0" TextColor="#0F172A" SemanticProperties.Description="문제 연습 화면 열기">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsPracticeWorkspaceSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0F172A" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="오답" Command="{Binding ShowWrongWorkspaceCommand}" CornerRadius="12" Padding="14,10" BackgroundColor="#E2E8F0" TextColor="#0F172A" SemanticProperties.Description="오답 노트 화면 열기">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsWrongWorkspaceSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0F172A" />
                                <Setter Property="TextColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Frame>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <ScrollView IsVisible="{Binding ShowImportWorkspace}">
                <VerticalStackLayout Spacing="16">
                    <Grid IsVisible="{Binding UseWideWorkspaceLayout}" ColumnDefinitions="6*,5*" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="16">
                            <Frame Padding="16" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                                <VerticalStackLayout Spacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="카테고리 관리" FontAttributes="Bold" FontSize="20" TextColor="#0F172A" />
                                        <Label Text="문항 반영 전에 카테고리를 고르고 유지합니다." TextColor="#64748B" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Entry Placeholder="새 카테고리 이름"
                                           Text="{Binding NewCategoryName}"
                                           IsEnabled="{Binding CanModifyQuestionStructure}"
                                           ClearButtonVisibility="WhileEditing"
                                           MaxLength="60"
                                           ReturnType="Done"
                                           SemanticProperties.Description="새 카테고리 이름 입력" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" Text="카테고리 추가" Command="{Binding AddCategoryCommand}" IsEnabled="{Binding CanAddCategory}" />
                                        <Button Grid.Column="1"
                                                Text="현재 카테고리 삭제"
                                                Command="{Binding DeleteCategoryCommand}"
                                                IsEnabled="{Binding CanDeleteCategory}"
                                                BackgroundColor="#FEF2F2"
                                                TextColor="#B91C1C" />
                                    </Grid>
                                    <Picker Title="카테고리 선택"
                                            ItemsSource="{Binding Categories}"
                                            SelectedItem="{Binding SelectedCategory}"
                                            IsEnabled="{Binding CanModifyQuestionStructure}">
                                        <Picker.ItemDisplayBinding>
                                            <Binding Path="Name" x:DataType="models:Category" />
                                        </Picker.ItemDisplayBinding>
                                    </Picker>
                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSelectedCategoryLoading}">
                                        <ActivityIndicator IsRunning="{Binding IsSelectedCategoryLoading}" Color="#0EA5E9" />
                                        <Label Text="선택한 카테고리의 문항을 불러오는 중입니다."
                                               FontSize="12"
                                               TextColor="#475569"
                                               VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Padding="16" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                                <VerticalStackLayout Spacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="문항 가져오기" FontAttributes="Bold" FontSize="20" TextColor="#0F172A" />
                                        <Label Text="PDF 선택, 문제 수 입력, 정답 맵 연결, 분석 상태 확인까지 한 번에 처리합니다." TextColor="#64748B" FontSize="12" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Picker Grid.Column="0"
                                                Title="문항 파일 선택"
                                                ItemsSource="{Binding SourceFilesDirectory}"
                                                SelectedItem="{Binding SelectedSourceFileName}"
                                                IsEnabled="{Binding CanModifyQuestionStructure}" />
                                        <Button Grid.Column="1"
                                                Text="새로고침"
                                                Command="{Binding LoadSourceFilesFromDirectoryCommand}"
                                                IsEnabled="{Binding CanModifyQuestionStructure}" />
                                    </Grid>

                                    <Button Text="문항 PDF 추가"
                                            Command="{Binding ImportSourceFileCommand}"
                                            IsEnabled="{Binding CanModifyQuestionStructure}"
                                            SemanticProperties.Description="기기에서 PDF 파일을 골라 앱에 복사" />

                                    <HorizontalStackLayout Spacing="8"
                                                           IsVisible="{Binding IsSourceFileImportInProgress}"
                                                           SemanticProperties.Description="문항 PDF를 안전하게 복사하는 중">
                                        <ActivityIndicator IsRunning="{Binding IsSourceFileImportInProgress}"
                                                           Color="#0EA5E9" />
                                        <Label Text="PDF를 안전하게 복사하는 중입니다."
                                               VerticalTextAlignment="Center"
                                               TextColor="#475569" />
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="예상 문항 수 또는 범위" FontAttributes="Bold" />
                                        <Entry Placeholder="예: 25 또는 31-55"
                                               Text="{Binding ExpectedQuestionRangeText}"
                                               IsEnabled="{Binding CanModifyQuestionStructure}"
                                               MaxLength="11"
                                               SemanticProperties.Description="예상 문항 개수 또는 시작-끝 번호 입력" />
                                        <Label Text="숫자만 입력하면 시작 번호를 자동 추정합니다." FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="정답 맵" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Text="정답 파일 불러오기"
                                                    Command="{Binding LoadAnswerFileCommand}"
                                                    IsEnabled="{Binding CanModifyQuestionStructure}" />
                                        </Grid>
                                        <Editor HeightRequest="200"
                                                Placeholder="예: 1:3|4, 2:정답"
                                                Text="{Binding AnswerMapText}"
                                                IsEnabled="{Binding CanModifyQuestionStructure}"
                                                SemanticProperties.Description="문항 번호와 정답을 입력하거나 정답 파일을 불러오기" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Switch IsToggled="{Binding OverwriteExisting}"
                                                IsEnabled="{Binding CanModifyQuestionStructure}"
                                                SemanticProperties.Description="동일 파일명 문항 덮어쓰기" />
                                        <Label Grid.Column="1" Text="동일 파일명 문항이 있으면 확인 후 덮어씁니다." VerticalTextAlignment="Center" TextColor="#475569" />
                                    </Grid>

                                    <Frame Padding="10" BorderColor="#FBBF24" BackgroundColor="#FFFBEB" HasShadow="False" IsVisible="{Binding ShowPdfAnalysisUnsupportedNotice}">
                                        <Label Text="현재 iOS에서는 PDF OCR 분석을 지원하지 않습니다. 다른 지원 플랫폼에서 문항을 먼저 반영해 주세요."
                                               TextColor="#92400E"
                                               LineBreakMode="WordWrap" />
                                    </Frame>

                                    <Frame Padding="12" BorderColor="#BFDBFE" BackgroundColor="#EFF6FF" HasShadow="False" IsVisible="{Binding ShowPdfAnalysisPanel}">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="분석 상태" FontAttributes="Bold" TextColor="#1D4ED8" />
                                                <ActivityIndicator Grid.Column="1"
                                                                   IsRunning="{Binding IsPdfAnalysisInProgress}"
                                                                   IsVisible="{Binding IsPdfAnalysisInProgress}"
                                                                   Color="#0EA5E9"
                                                                   SemanticProperties.Description="PDF 분석 진행 중" />
                                            </Grid>
                                            <Label Text="{Binding PdfAnalysisSummary}" TextColor="#1E293B" LineBreakMode="WordWrap" />
                                            <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowPdfAnalysisProgress}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding PdfAnalysisStatus}" TextColor="{Binding PdfAnalysisStatusColor}" LineBreakMode="WordWrap" VerticalTextAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Text="분석 취소"
                                                            Command="{Binding CancelPdfAnalysisCommand}"
                                                            IsVisible="{Binding IsPdfAnalysisInProgress}"
                                                            IsEnabled="{Binding CanCancelPdfAnalysis}"
                                                            BackgroundColor="#FFF7ED"
                                                            TextColor="#C2410C"
                                                            SemanticProperties.Description="진행 중인 PDF 문항 분석 취소" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding PdfAnalysisProgressValue}" ProgressColor="#0EA5E9" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding PdfAnalysisProgressText}" TextColor="#475569" FontSize="12" />
                                                    <Label Grid.Column="1" Text="{Binding PdfAnalysisSpeedText}" TextColor="#475569" FontSize="12" />
                                                </Grid>
                                            </VerticalStackLayout>
                                            <Button Text="최근 분석 진단 보기"
                                                    Clicked="OnOpenLatestDiagnosticsClicked"
                                                    IsVisible="{Binding HasLatestPdfDiagnostics}"
                                                    IsEnabled="{Binding HasLatestPdfDiagnostics}"
                                                    BackgroundColor="#FFFFFF"
                                                    TextColor="#1D4ED8"
                                                    BorderColor="#93C5FD"
                                                    SemanticProperties.Description="저장 여부와 관계없이 최근 PDF 구조 분석 진단 열기" />
                                        </VerticalStackLayout>
                                    </Frame>

                                    <Button Text="문항 반영하기"
                                            Command="{Binding ImportAnswerMapCommand}"
                                            IsEnabled="{Binding CanImportAnswerMap}"
                                            HeightRequest="48"
                                            BackgroundColor="#0F172A"
                                            TextColor="#FFFFFF" />
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>

                        <Frame Grid.Column="1" Padding="16" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="등록된 파일" FontAttributes="Bold" FontSize="20" TextColor="#0F172A" />
                                    <Label Text="분석 결과와 저장 문항은 '보기'로 확인하고, 잘못 들어간 파일은 바로 삭제합니다." TextColor="#64748B" FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SourceFiles}">
                                    <BindableLayout.EmptyView>
                                        <Label Text="등록된 파일이 없습니다." TextColor="#64748B" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:SourceFileSummary">
                                            <Frame Padding="12" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                                                <VerticalStackLayout Spacing="10">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="{Binding DisplayText}" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding SourceFileName}" FontSize="12" TextColor="#64748B" LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Button Text="보기" Clicked="OnOpenSourceFileReviewClicked" CommandParameter="{Binding}" />
                                                        <Button Text="삭제"
                                                                Clicked="OnDeleteSourceFileClicked"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanDelete}"
                                                                BackgroundColor="#FEF2F2"
                                                                TextColor="#B91C1C"
                                                                SemanticProperties.Description="이 파일에 저장된 문항 삭제" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding UseWideWorkspaceLayout}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Frame Padding="16" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="카테고리 관리" FontAttributes="Bold" FontSize="20" TextColor="#0F172A" />
                                    <Label Text="문항 반영 전에 카테고리를 고르고 유지합니다." TextColor="#64748B" FontSize="12" />
                                </VerticalStackLayout>
                                <Entry Placeholder="새 카테고리 이름"
                                       Text="{Binding NewCategoryName}"
                                       IsEnabled="{Binding CanModifyQuestionStructure}"
                                       ClearButtonVisibility="WhileEditing"
                                       MaxLength="60"
                                       ReturnType="Done"
                                       SemanticProperties.Description="새 카테고리 이름 입력" />
                                <Button Text="카테고리 추가" Command="{Binding AddCategoryCommand}" IsEnabled="{Binding CanAddCategory}" />
                                <Button Text="현재 카테고리 삭제"
                                        Command="{Binding DeleteCategoryCommand}"
                                        IsEnabled="{Binding CanDeleteCategory}"
                                        BackgroundColor="#FEF2F2"
                                        TextColor="#B91C1C" />
                                <Picker Title="카테고리 선택"
                                        ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        IsEnabled="{Binding CanModifyQuestionStructure}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="Name" x:DataType="models:Category" />
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSelectedCategoryLoading}">
                                    <ActivityIndicator IsRunning="{Binding IsSelectedCategoryLoading}" Color="#0EA5E9" />
                                    <Label Text="선택한 카테고리의 문항을 불러오는 중입니다."
                                           FontSize="12"
                                           TextColor="#475569"
                                           VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Padding="16" BorderColor="#CBD5E1" BackgroundColor="#FFFFFF" HasShadow="False">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="문항 가져오기" FontAttributes="Bold" FontSize="20" TextColor="#0F172A" />
                                    <Label Text="모바일에서는 위에서 아래 순서로 끊기지 않게 한 단계씩 진행합니다." TextColor="#64748B" FontSize="12" />
                                </VerticalStackLayout>

                                <Picker Title="문항 파일 선택"
                                        ItemsSource="{Binding SourceFilesDirectory}"
                                        SelectedItem="{Binding SelectedSourceFileName}"
                                        IsEnabled="{Binding CanModifyQuestionStructure}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="새로고침"
                                            Command="{Binding LoadSourceFilesFromDirectoryCommand}"
                                            IsEnabled="{Binding CanModifyQuestionStructure}" />
                                    <Button Grid.Column="1"
                                            Text="문항 PDF 추가"
                                            Command="{Binding ImportSourceFileCommand}"
                                            IsEnabled="{Binding CanModifyQuestionStructure}"
                                            SemanticProperties.Description="기기에서 PDF 파일을 골라 앱에 복사" />
                                </Grid>

                                <HorizontalStackLayout Spacing="8"
                                                       IsVisible="{Binding IsSourceFileImportInProgress}"
                                                       SemanticProperties.Description="문항 PDF를 안전하게 복사하는 중">
                                    <ActivityIndicator IsRunning="{Binding IsSourceFileImportInProgress}"
                                                       Color="#0EA5E9" />
                                    <Label Text="PDF를 안전하게 복사하는 중입니다."
                                           VerticalTextAlignment="Center"
                                           TextColor="#475569" />
                                </HorizontalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="예상 문항 수 또는 범위" FontAttributes="Bold" />
                                    <Entry Placeholder="예: 25 또는 31-55"
                                           Text="{Binding ExpectedQuestionRangeText}"
                                           IsEnabled="{Binding CanModifyQuestionStructure}"
                                           MaxLength="11"
                                           SemanticProperties.Description="예상 문항 개수 또는 시작-끝 번호 입력" />
                                    <Label Text="숫자만 입력하면 시작 번호를 자동 추정합니다." FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="정답 맵" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Text="정답 파일 불러오기"
                                            Command="{Binding LoadAnswerFileCommand}"
                                            IsEnabled="{Binding CanModifyQuestionStructure}" />
